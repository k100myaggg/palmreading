---
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
---

<header class="site-header">
  <div class="container-wide nav-inner">
    <a href="/" class="brand-logo" aria-label="AuraPalm Homepage">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">AuraPalm</span>
        <span class="brand-subtitle">Vedic Chiromancy &amp; Destiny Readings</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="nav-links">
      <a href="/guides.html" class={`nav-link ${activePage === 'guides' ? 'active' : ''}`} data-i18n="nav.explore">Explore Readings</a>
      <a href="/scanner.html" class={`nav-link ${activePage === 'scanner' ? 'active' : ''}`} data-i18n="nav.scanner">Interactive Scanner</a>
      <a href="/report.html" class={`nav-link ${activePage === 'report' ? 'active' : ''}`} data-i18n="nav.report">My Destiny Report</a>
      <a href="/palmists.html" class={`nav-link ${activePage === 'palmists' ? 'active' : ''}`} data-i18n="nav.palmists">Master Palmists</a>
      <a href="/guides.html#journal" class="nav-link" data-i18n="nav.journal">Astrology Journal</a>
    </nav>

    <!-- Action Items & Theme + Language Toggle -->
    <div class="nav-actions">
      <!-- Language Switcher: EN | HI -->
      <button class="lang-toggle-btn" title="Switch language (English / हिन्दी)" aria-label="Toggle language">
        <span class="lang-code active">EN</span><span class="lang-sep">|</span><span class="lang-code">हिं</span>
      </button>

      <!-- Theme Switcher: Light Mode default, Dark Mode toggle -->
      <button class="theme-toggle-btn" title="Toggle Celestial Dark / Light Theme" aria-label="Toggle theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="/scanner.html" class="btn btn-primary btn-glow" data-i18n="nav.scanBtn">SCAN YOUR PALM</a>
      
      <button class="icon-btn" aria-label="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="badge-dot"></span>
      </button>

      <div class="avatar-nav" title="Sophia Thorne">
        <img src="/images/master-sophia.jpg" alt="Master Palmist Profile Avatar" width="38" height="38">
      </div>

      <button class="mobile-menu-toggle" aria-label="Open mobile menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>
