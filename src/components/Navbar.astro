---
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
---

<header class="archive-header site-header">
  <!-- Archival Metadata Top Strip -->
  <div class="archive-topbar">
    <div class="archive-container archive-topbar-inner">
      <div class="archive-metadata-item">
        <span class="archive-badge-dot"></span>
        <span class="archive-mono">सामुद्रिक शास्त्र • पाण्डुलिपि अभिलेख</span>
      </div>
      <div class="archive-metadata-item hide-mobile">
        <span class="archive-mono">SAMUDRIKA DIGITAL ARCHIVE • FOLIO CATALOGUE 2026</span>
      </div>
      <div class="archive-metadata-item">
        <span class="archive-mono">अभिलेख सं. HST-01</span>
      </div>
    </div>
  </div>

  <!-- Main Archival Navigation Bar -->
  <div class="archive-nav-main">
    <div class="archive-container nav-inner">
      <!-- Brand: हस्तरेखा अभिलेख / HASTAREKHA ARCHIVE -->
      <a href="/" class="archive-brand" aria-label="हस्तरेखा अभिलेख मुख्य पृष्ठ">
        <div class="archive-brand-seal">
          <span class="seal-glyph">❦</span>
        </div>
        <div class="archive-brand-titles">
          <span class="archive-brand-hi">हस्तरेखा अभिलेख</span>
          <span class="archive-brand-en">HASTAREKHA ARCHIVE</span>
        </div>
      </a>

      <!-- Historical Navigation Links -->
      <nav class="archive-nav-links" aria-label="मुख्य सूची">
        <a 
          href="/scanner.html" 
          class={`archive-nav-link ${activePage === 'scanner' ? 'active' : ''}`}
        >
          <span class="nav-hi">हस्तरेखा पढ़ें</span>
          <span class="nav-en">READ PALM</span>
        </a>
        <a 
          href="/#protocol" 
          class="archive-nav-link"
        >
          <span class="nav-hi">पठन विधि</span>
          <span class="nav-en">PROTOCOL</span>
        </a>
        <a 
          href="/guides.html" 
          class={`archive-nav-link ${activePage === 'guides' ? 'active' : ''}`}
        >
          <span class="nav-hi">प्राचीन ग्रंथ</span>
          <span class="nav-en">TREATISES</span>
        </a>
        <a 
          href="/report.html" 
          class={`archive-nav-link ${activePage === 'report' ? 'active' : ''}`}
        >
          <span class="nav-hi">मेरा अभिलेख</span>
          <span class="nav-en">MY FOLIO</span>
        </a>
      </nav>

      <!-- Archival Actions -->
      <div class="archive-nav-actions">
        <!-- Language Switcher: EN | HI -->
        <button class="lang-toggle-btn archive-lang-btn" title="भाषा बदलें (हिन्दी / English)" aria-label="Toggle language">
          <span class="lang-code active">हिं</span><span class="lang-sep">/</span><span class="lang-code">EN</span>
        </button>

        <!-- Theme Toggle: Paper / Carbon Ink -->
        <button class="theme-toggle-btn archive-theme-btn" title="पाण्डुलिपि प्रकाश / स्याही मोड बदलें" aria-label="Toggle parchment / carbon ink mode">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="theme-icon">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <!-- Primary CTA: हस्तरेखा पढ़ें → -->
        <a href="/scanner.html" class="btn-archive-primary">
          <span>हस्तरेखा पढ़ें</span>
          <span class="btn-arrow">→</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button class="mobile-menu-toggle archive-mobile-btn" aria-label="अभिलेख सूची खोलें">
          <span class="menu-icon-bars"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer / Folio Index -->
  <div class="archive-mobile-drawer" id="mobile-archive-drawer">
    <div class="archive-mobile-inner">
      <div class="archive-mobile-header">
        <span class="archive-mono">अनुक्रम सूची • FOLIO INDEX</span>
      </div>
      <div class="archive-mobile-links">
        <a href="/scanner.html" class="archive-mobile-link">
          <span class="mobile-num">०१</span>
          <div>
            <div class="mobile-title">हस्तरेखा पढ़ें</div>
            <div class="mobile-sub">READ PALM • SCANNER</div>
          </div>
        </a>
        <a href="/#protocol" class="archive-mobile-link">
          <span class="mobile-num">०२</span>
          <div>
            <div class="mobile-title">पठन विधि</div>
            <div class="mobile-sub">THE READING PROTOCOL</div>
          </div>
        </a>
        <a href="/guides.html" class="archive-mobile-link">
          <span class="mobile-num">०३</span>
          <div>
            <div class="mobile-title">प्राचीन ग्रंथ</div>
            <div class="mobile-sub">CLASSICAL TREATISES</div>
          </div>
        </a>
        <a href="/report.html" class="archive-mobile-link">
          <span class="mobile-num">०४</span>
          <div>
            <div class="mobile-title">मेरा अभिलेख</div>
            <div class="mobile-sub">PERSONAL FOLIO REPORT</div>
          </div>
        </a>
      </div>
      <div class="archive-mobile-footer">
        <a href="/scanner.html" class="btn-archive-primary" style="width: 100%; text-align: center;">
          <span>हस्तरेखा पढ़ना प्रारम्भ करें →</span>
        </a>
      </div>
    </div>
  </div>
</header>
