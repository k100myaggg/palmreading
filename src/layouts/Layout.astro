---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/styles.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  activePage?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
}

const {
  title = "हस्तरेखा अभिलेख — HASTAREKHA ARCHIVE | वैदिक सामुद्रिक शास्त्र पाण्डुलिपि",
  description = "प्राचीन हस्तरेखा परंपराओं से प्रेरित एक विस्तृत डिजिटल अभिलेख। आपकी हथेली की प्रमुख रेखाओं और पर्वतों का शास्त्रीय अध्ययन, 2026 में डिजिटल रूप से संरक्षित।",
  keywords = "हस्तरेखा अभिलेख, Hastarekha Archive, Samudrika Shastra, Vedic palm reading, हस्तरेखा, हस्तरेखा ज्ञान, प्राचीन ग्रंथ, Palmistry manuscript",
  canonical = Astro.url.href,
  activePage = "home",
  ogImage = "/images/palm-base.jpg",
  jsonLd
} = Astro.props;

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://palmreading-b0v.pages.dev/#website",
      "url": "https://palmreading-b0v.pages.dev/",
      "name": "हस्तरेखा अभिलेख — HASTAREKHA ARCHIVE",
      "inLanguage": ["hi-IN", "en-IN"],
      "description": "प्राचीन भारतीय सामुद्रिक शास्त्र और हस्तरेखा परंपराओं का डिजिटल अभिलेख।",
      "publisher": {
        "@type": "Organization",
        "name": "हस्तरेखा अभिलेख संकलन",
        "logo": {
          "@type": "ImageObject",
          "url": "https://palmreading-b0v.pages.dev/images/palm-base.jpg"
        }
      }
    },
    {
      "@type": "WebApplication",
      "@id": "https://palmreading-b0v.pages.dev/#app",
      "name": "हस्तरेखा अभिलेख पठन प्रणाली",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "199",
        "priceCurrency": "INR"
      }
    }
  ]
};

const structuredData = jsonLd || defaultSchema;
---

<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonical} />

  <!-- Google Fonts: EB Garamond, Courier Prime, Noto Serif Devanagari, Tiro Devanagari Hindi -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Noto+Serif+Devanagari:wght@400;500;600;700&family=Tiro+Devanagari+Hindi:ital@0;1&display=swap" rel="stylesheet" />

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- AI Discovery & Machine-Readable Spec Links -->
  <link rel="help" type="text/plain" href="/llms.txt" title="LLM Agent Context" />
  <link rel="alternate" type="text/markdown" href="/pricing.md" title="Pricing Specification" />

  <!-- Favicon: Archival Vermillion Seal -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%238E1D12' rx='2'/><text x='16' y='22' font-family='serif' font-size='18' text-anchor='middle' fill='%23F7EFE7'>❦</text></svg>" />

  <!-- Early Theme Init Script to avoid FOUC / layout shift -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('aurapalm_theme') || 'light';
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    })();
  </script>

  <!-- JSON-LD Structured Data Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="archive-paper-canvas">
  <!-- Minimal Historical Archive Header -->
  <Navbar activePage={activePage} />

  <!-- Page Content -->
  <slot />

  <!-- Archival Colophon Footer -->
  <Footer />

  <!-- Universal Scripts -->
  <script is:inline type="module" src="/js/i18n.js"></script>
  <script is:inline type="module" src="/js/theme.js"></script>
  <script is:inline type="module" src="/js/main.js"></script>
</body>
</html>
