  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Restore user palm image if available
      try {
        const savedImg = sessionStorage.getItem('aurapalm_scan_image');
        const printImg = document.getElementById('print-palm-img');
        if (savedImg && printImg) {
          printImg.src = savedImg;
        }
      } catch (e) {
        console.warn('Session image read failed', e);
      }

      // Restore polarity label
      try {
        const scanDataStr = sessionStorage.getItem('aurapalm_scan_result');
        if (scanDataStr) {
          const scanData = JSON.parse(scanDataStr);
          const polarityEl = document.getElementById('print-polarity-val');
          if (polarityEl && scanData.polarity) {
            polarityEl.innerText = scanData.polarity === 'left' ? 'वाम हस्त (बायां • अकर्मक)' : 'दक्षिण हस्त (दायां • कर्मक)';
          }
        }
      } catch (e) {
        console.warn('Scan data read failed', e);
      }

      // Print trigger button
      const printBtn = document.getElementById('toolbar-btn-print');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          window.print();
        });
      }

      // Auto-trigger print if query param ?print=true is present
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('print') === 'true') {
        setTimeout(() => {
          window.print();
        }, 600);
      }
    });
  </script>
