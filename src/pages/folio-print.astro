---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "हस्तरेखा अभिलेख — व्यक्तिगत हस्त-पठन पाण्डुलिपि",
  "author": {
    "@type": "Organization",
    "name": "हस्तरेखा अभिलेख संकलन"
  },
  "inLanguage": ["hi-IN", "en-IN"]
};
---

<Layout
  title="HASTAREKHA ARCHIVE • FOLIO 184 | ऐतिहासिक हस्तरेखा पाण्डुलिपि"
  description="1800s Indian scholarly book & archival manuscript edition of your personal palmistry record. Samudrika Shastra series."
  activePage="report"
  jsonLd={jsonLd}
>
  <!-- Print & Reader Top Floating Toolbar (Hidden when printed) -->
  <div class="print-toolbar no-print" id="print-toolbar">
    <div class="archive-container toolbar-inner">
      <div class="toolbar-left">
        <a href="/report.html" class="toolbar-back-btn">← अभिलेख पृष्ठ पर वापस जाएं</a>
        <span class="toolbar-folio-id">FOLIO NO. 184 • SAMUDRIKA SHASTRA SERIES</span>
      </div>
      <div class="toolbar-actions">
        <button id="toolbar-btn-print" class="btn-archive-primary" type="button">
          <span>🖨️ PDF डाउनलोड करें / मुद्रण करें</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Historical Book & Manuscript Document Container -->
  <div class="historical-book-canvas" id="historical-book-root">

    <!-- ========================================================
         PAGE 1: BOOK COVER (आवरण)
         ======================================================== -->
    <article class="manuscript-page book-cover-page">
      <div class="cover-frame-outer">
        <div class="cover-frame-inner">

          <!-- Corner Fleurons -->
          <span class="cover-corner corner-tl">❦</span>
          <span class="cover-corner corner-tr">❦</span>
          <span class="cover-corner corner-bl">❦</span>
          <span class="cover-corner corner-br">❦</span>

          <!-- Top Rule & Header -->
          <div class="cover-top-meta">
            <span class="cover-series-name">SAMUDRIKA SHASTRA HISTORICAL MANUSCRIPT SERIES</span>
            <div class="cover-rule"></div>
          </div>

          <!-- Main Titles -->
          <div class="cover-titles-block">
            <h1 class="cover-main-title-hi">हस्तरेखा अभिलेख</h1>
            <h2 class="cover-main-title-en">HASTAREKHA ARCHIVE</h2>

            <div class="cover-fleuron-divider">❦</div>

            <h3 class="cover-sub-title-hi">व्यक्तिगत हस्त-पठन</h3>
            <h4 class="cover-sub-title-en">PERSONAL FOLIO</h4>

            <div class="cover-folio-badge">
              <span>FOLIO NO. 184</span>
            </div>

            <p class="cover-series-sub">SAMUDRIKA SHASTRA SERIES</p>
          </div>

          <!-- Central Ornamental Seal -->
          <div class="cover-seal-wrapper">
            <div class="cover-double-seal">
              <span class="seal-inner-glyph">ह</span>
            </div>
            <span class="seal-sanskrit-motto">यथा हस्ते तथा भाव्ये</span>
            <span class="seal-motto-sub">"As inscribed in the palm, so unfolds the destiny"</span>
          </div>

          <!-- Cover Bottom Colophon -->
          <div class="cover-bottom-meta">
            <div class="cover-rule"></div>
            <div class="cover-fleuron-divider">❦</div>
            <p class="cover-preservation-text">संकलित एवं संरक्षित</p>
            <p class="cover-year-text">2026</p>
            <p class="cover-archive-id">REGISTRATION ID: HST-2026-0184 • FIRST CLASS DOCUMENTARY FOLIO</p>
          </div>

        </div>
      </div>
    </article>

    <!-- ========================================================
         PAGE 2: PREFACE & TABLE OF CHAPTERS (विषय-सूची)
         ======================================================== -->
    <article class="manuscript-page">
      <header class="page-running-header">
        <span>HASTAREKHA ARCHIVE • FOLIO 184</span>
        <span>SAMUDRIKA SHASTRA</span>
      </header>

      <div class="page-content-wrapper">
        <div class="chapter-opening-slate">
          <span class="chapter-number-tag">प्रस्तावना एवं विषय-सूची</span>
          <h2 class="chapter-title-slate">अभिलेख का अनुक्रम</h2>
          <div class="ornamental-fleuron-rule">❧ ❧ ❧</div>
        </div>

        <blockquote class="manuscript-quote">
          "अङ्गुष्ठमूलतः पूर्वा रेखा भवति जीविनः। मध्यमा बुद्धिदा ज्ञेया कनिष्ठा हृदयान्विता॥"<br />
          <cite>— प्राचीन हस्तसंजीवन सामुद्रिक संहिता</cite>
        </blockquote>

        <p class="manuscript-paragraph">
          प्रस्तुत पाण्डुलिपि १८वीं एवं १९वीं शताब्दी के भारतीय सामुद्रिक शास्त्र ग्रंथों—विशेषतः समुद्र-संहिता, हस्तसंजीवन तथा वाराहीय संहिता—की शास्त्रीय परंपरा के आधार पर तैयार की गई है। इस अभिलेख में आपके हस्तचिह्न की रेखाओं, पर्वतों तथा सूक्ष्म लक्षणों का निष्पक्ष एवं मर्यादापूर्ण अध्ययन संकलित है।
        </p>

        <!-- Chapter Index Table -->
        <div class="manuscript-toc-table">
          <div class="toc-row">
            <span class="toc-chap">अध्याय I</span>
            <span class="toc-name">हस्तचिह्न का परिचय एवं मूल प्रकृति</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०३</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अध्याय II</span>
            <span class="toc-name">प्रमुख रेखाओं का शास्त्रीय विन्यास</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०४</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अध्याय III</span>
            <span class="toc-name">सप्त ग्रहों के पर्वतों का उत्थान एवं प्रभाव</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०५</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अध्याय IV</span>
            <span class="toc-name">स्वभाव एवं व्यक्तित्व का अभिलेख</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०६</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अध्याय V</span>
            <span class="toc-name">कार्य, आजीविका एवं भाग्योदय काल</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०७</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अध्याय VI</span>
            <span class="toc-name">संबंध, संवेदनशीलता एवं आत्मीय योग</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०८</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अध्याय VII</span>
            <span class="toc-name">दुर्लभ चिह्न एवं विशिष्ट अवलोकन</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ ०९</span>
          </div>
          <div class="toc-row">
            <span class="toc-chap">अंतिम पृष्ठ</span>
            <span class="toc-name">अभिलेखीय टिप्पणी एवं शास्त्रीय मुहर</span>
            <span class="toc-dots"></span>
            <span class="toc-page">पृष्ठ १०</span>
          </div>
        </div>
      </div>

      <footer class="page-running-footer">
        <span>पृष्ठ ०२ • निजी अभिलेख • गोपनीय</span>
        <span>हस्तरेखा अभिलेख संकलन</span>
      </footer>
    </article>

    <!-- ========================================================
         PAGE 3: CHAPTER I — हस्तचिह्न का परिचय
         ======================================================== -->
    <article class="manuscript-page">
      <header class="page-running-header">
        <span>HASTAREKHA ARCHIVE • FOLIO 184</span>
        <span>अध्याय I • हस्तचिह्न परिचय</span>
      </header>

      <div class="page-content-wrapper">
        <div class="chapter-opening-slate">
          <span class="chapter-number-tag">अध्याय I</span>
          <h2 class="chapter-title-slate">हस्तचिह्न का परिचय</h2>
          <div class="ornamental-fleuron-rule">❧ ❧ ❧</div>
        </div>

        <p class="manuscript-paragraph has-dropcap">
          <span class="dropcap">ह</span>स्त केवल बाह्य चर्म की सूक्ष्म परतों का समुच्चय नहीं है; प्राचीन वैदिक परंपरा में इसे अंतःकरण एवं जीवन के संचित संस्कारों का दृश्य मानचित्र स्वीकार किया गया है। जब भी किसी हथेली का परीक्षण किया जाता है, तो रेखाओं से पूर्व हथेली की समग्र बनावट, त्वचा की स्निग्धता तथा अंगुलियों के संतुलन का अवलोकन अनिवार्य होता है।
        </p>

        <!-- Specimen Identity Ledger -->
        <div class="manuscript-specimen-ledger">
          <div class="ledger-row">
            <span class="ledger-label">परीक्षित हस्त:</span>
            <span class="ledger-val" id="print-polarity-val">दक्षिण हस्त (कर्मक • Manifested Reality)</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">तत्व वर्गीकरण:</span>
            <span class="ledger-val">जल एवं वायु तत्व का दुर्लभ सामंजस्य</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">त्वचा की प्रकृति:</span>
            <span class="ledger-val">स्निग्ध, कोमल एवं संवेदनशील (सत्त्व-प्रधान)</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">अंगुली विन्यास:</span>
            <span class="ledger-val">तर्जनी एवं अनामिका का संतुलित समानांतर अनुपात</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">अभिलेखीय स्थिति:</span>
            <span class="ledger-val">प्रथम श्रेणी सुरक्षित पाण्डुलिपि</span>
          </div>
        </div>

        <p class="manuscript-paragraph">
          आपके हस्तचिह्न का प्राथमिक निरीक्षण यह दर्शाता है कि आपकी शारीरिक ऊर्जा तथा मानसिक गतिशीलता परस्पर पूरक रूप से कार्य कर रही हैं। जल तत्व की प्रधानता आपकी गहरी आत्मीय संवेदनशीलता, अंतर्ज्ञान तथा निष्कपट निष्ठा को पोषण देती है, जबकि वायु तत्व का संगम आपको तीक्ष्ण विचार-शक्ति, स्वतंत्र विश्लेषण तथा रचनात्मक अभिव्यक्ति की सामर्थ्य प्रदान करता है।
        </p>

        <div class="marginal-scholarly-note">
          <strong>शास्त्रीय टिप्पणी:</strong> "दक्षिण हस्ते वर्तमानकर्म प्रस्फुटति"—दक्षिण हस्त व्यक्ति के वर्तमान उद्यम एवं स्वतंत्र संकल्प से अर्जित उपलब्धियों को प्रकट करता है।
        </div>
      </div>

      <footer class="page-running-footer">
        <span>पृष्ठ ०३ • निजी अभिलेख • गोपनीय</span>
        <span>हस्तरेखा अभिलेख संकलन</span>
      </footer>
    </article>

    <!-- ========================================================
         PAGE 4: CHAPTER II — प्रमुख रेखाएँ (Core Meridians)
         ======================================================== -->
    <article class="manuscript-page">
      <header class="page-running-header">
        <span>HASTAREKHA ARCHIVE • FOLIO 184</span>
        <span>अध्याय II • प्रमुख रेखाएँ</span>
      </header>

      <div class="page-content-wrapper">
        <div class="chapter-opening-slate">
          <span class="chapter-number-tag">अध्याय II</span>
          <h2 class="chapter-title-slate">प्रमुख रेखाएँ</h2>
          <div class="ornamental-fleuron-rule">❧ ❧ ❧</div>
        </div>

        <!-- Archival Diagram Plate -->
        <div class="print-diagram-plate">
          <div class="diagram-caption-top">PLATE II-A • हस्तरेखा विन्यास एवं रेखा-प्रवाह</div>
          <div class="diagram-render-wrap">
            <img id="print-palm-img" class="print-palm-photo" src="/images/palm-base.jpg" alt="परीक्षित हस्त आरेखन" />
            
            <svg class="print-svg-overlay" viewBox="0 0 600 700">
              <!-- Ayur Rekha (Vermillion) -->
              <path d="M225 255 C185 325 175 465 260 565" stroke="#8E1D12" stroke-width="3" fill="none" />
              <!-- Matisha Rekha (Copper) -->
              <path d="M145 330 C225 345 335 370 420 430" stroke="#95663D" stroke-width="3" fill="none" />
              <!-- Hridaya Rekha (Vermillion) -->
              <path d="M155 295 C235 305 325 265 405 235" stroke="#8E1D12" stroke-width="3.5" fill="none" />
              <!-- Bhagya Rekha (Dashed Copper) -->
              <path d="M305 580 L295 260" stroke="#95663D" stroke-width="2.5" stroke-dasharray="6 4" fill="none" />
            </svg>

            <!-- Line Marker Callouts in Courier Prime -->
            <div class="print-callout callout-life">01 — जीवन रेखा (AYUR REKHA)</div>
            <div class="print-callout callout-head">02 — मस्तिष्क रेखा (MATISHA REKHA)</div>
            <div class="print-callout callout-heart">03 — हृदय रेखा (HRIDAYA REKHA)</div>
            <div class="print-callout callout-fate">04 — भाग्य रेखा (BHAGYA REKHA)</div>
          </div>
        </div>

        <!-- Detailed Rekha Explanations -->
        <div class="rekha-narrative-grid">
          <div class="rekha-block">
            <h4 class="rekha-name">०१. जीवन रेखा (AYUR REKHA)</h4>
            <p class="rekha-desc">
              शुक्र पर्वत को घेरती हुई यह रेखा गहरी, अखंडित एवं निर्दोष है। किसी भी बड़े कट या द्वीप का अभाव दीर्घायु बल, उत्कृष्ट स्नायु-आरोग्यता तथा रोग-प्रतिरोधक सामर्थ्य का परिचायक है। मध्य भाग में सूक्ष्म मंगल रेखा अदृश्य कुल संरक्षण की पुष्टि करती है।
            </p>
          </div>
          <div class="rekha-block">
            <h4 class="rekha-name">०२. मस्तिष्क रेखा (MATISHA REKHA)</h4>
            <p class="rekha-desc">
              तर्जनी के मूल से निकलकर चंद्र पर्वत की दिशा में ढलने वाली यह रेखा अंत में द्विमुखी (लेखक-द्विमुख) रूप धारण करती है। यह व्यावहारिक तार्किक संतुलन और दूरदर्शी कल्पनाशीलता का श्रेष्ठ समन्वय दर्शाती है।
            </p>
          </div>
          <div class="rekha-block">
            <h4 class="rekha-name">०३. हृदय रेखा (HRIDAYA REKHA)</h4>
            <p class="rekha-desc">
              हृदय रेखा अनामिका के नीचे से एक संतुलित चाप बनाती हुई सीधे देवगुरु बृहस्पति के पर्वत पर प्रतिष्ठित होती है। यह भावनात्मक गरिमा, निष्कपट निष्ठा तथा आत्मीय संबंधों में सतहीपन के प्रति स्वाभाविक वितृष्णा को व्यक्त करती है।
            </p>
          </div>
          <div class="rekha-block">
            <h4 class="rekha-name">०४. भाग्य रेखा (BHAGYA REKHA)</h4>
            <p class="rekha-desc">
              मणिबंध के समीप चंद्र पर्वत से प्रारंभ होकर शनि पर्वत की ओर ऊर्ध्वगामी होने वाली यह रेखा स्वअर्जित सफलता का प्रतीक है। ३२वें वर्ष के उपरांत भाग्य रेखा में विशेष प्रखरता दृष्टिगोचर होती है।
            </p>
          </div>
        </div>
      </div>

      <footer class="page-running-footer">
        <span>पृष्ठ ०४ • निजी अभिलेख • गोपनीय</span>
        <span>हस्तरेखा अभिलेख संकलन</span>
      </footer>
    </article>

    <!-- ========================================================
         PAGE 5: CHAPTER III — पर्वतों का अध्ययन (Planetary Mounts)
         ======================================================== -->
    <article class="manuscript-page">
      <header class="page-running-header">
        <span>HASTAREKHA ARCHIVE • FOLIO 184</span>
        <span>अध्याय III • पर्वतों का अध्ययन</span>
      </header>

      <div class="page-content-wrapper">
        <div class="chapter-opening-slate">
          <span class="chapter-number-tag">अध्याय III</span>
          <h2 class="chapter-title-slate">पर्वतों का अध्ययन</h2>
          <div class="ornamental-fleuron-rule">❧ ❧ ❧</div>
        </div>

        <p class="manuscript-paragraph has-dropcap">
          <span class="dropcap">सा</span>मुद्रिक शास्त्र के अनुसार प्रत्येक अंगुली के नीचे स्थित मांसल उभार किसी विशिष्ट ग्रह की ऊर्जा का केंद्र माना गया है। इन पर्वतों का संतुलित उत्थान व्यक्ति के आंतरिक स्वभाव एवं बाहरी जीवन की दिशा को नियंत्रित करता है।
        </p>

        <!-- Mounts Grid -->
        <div class="print-mounts-grid">
          <div class="mount-box">
            <div class="mount-header-row">
              <span class="mount-title">१. गुरु पर्वत (MOUNT OF JUPITER)</span>
              <span class="mount-strength">उत्थान: ९०% • सुदृढ़</span>
            </div>
            <p class="mount-text">
              तर्जनी के नीचे स्थित गुरु पर्वत का यह श्रेष्ठ उत्थान आत्मसम्मान, नेतृत्व क्षमता, धार्मिक मर्यादा तथा उच्च जीवन मूल्यों के प्रति स्वाभाविक निष्ठा का सूचक है।
            </p>
          </div>

          <div class="mount-box">
            <div class="mount-header-row">
              <span class="mount-title">२. शनि पर्वत (MOUNT OF SATURN)</span>
              <span class="mount-strength">उत्थान: ८४% • समशीतोष्ण</span>
            </div>
            <p class="mount-text">
