---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Hastarekha Archive • Folio VII Hasta Pariksha",
  "url": "https://palmreading-b0v.pages.dev/scanner.html",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "All",
  "description": "Archival palm examination plate based on 18th-century Vedic Samudrika Shastra manuscript traditions.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};
---

<Layout
  title="FOLIO VII • HASTA PARIKSHA | हस्तरेखा अभिलेख"
  description="अपनी हथेली प्रस्तुत करें। स्पष्ट प्रकाश में हथेली का चित्र लें। रेखाएँ जितनी स्पष्ट होंगी, पठन उतना ही विस्तृत होगा।"
  keywords="hasta pariksha, palm examination, hastarekha archive, samudrika shastra, palm reading"
  activePage="scanner"
  jsonLd={jsonLd}
>
  <main class="archive-examination-page">
    <div class="archive-container">

      <!-- Folio Header -->
      <header class="examination-folio-header">
        <div class="folio-tag-row">
          <span class="folio-num-badge">FOLIO VII • HASTA PARIKSHA</span>
          <span class="folio-meta-stamp">पत्र संख्या ०७ • हस्तचिह्न परीक्षण</span>
        </div>
        <h1 class="examination-folio-title">अपनी हथेली प्रस्तुत करें</h1>
        <p class="examination-folio-desc">
          स्पष्ट प्रकाश में हथेली का चित्र लें। रेखाएँ जितनी स्पष्ट होंगी, पठन उतना ही विस्तृत होगा।
        </p>
        <div class="header-divider-ornament">
          <span class="ornament-line"></span>
          <span class="ornament-glyph">❧</span>
          <span class="ornament-line"></span>
        </div>
      </header>

      <!-- Polarity Selector Bar (Archival Manuscript Style) -->
      <section class="polarity-manuscript-section">
        <div class="polarity-plate">
          <div class="polarity-label-col">
            <span class="polarity-plate-tag">हस्त ध्रुवता • POLARITY</span>
            <span class="polarity-plate-instruction">परीक्षण हेतु हथेली चुनें:</span>
          </div>

          <div class="polarity-options-cluster">
            <button class="polarity-btn active" data-polarity="right" type="button">
              <span class="polarity-main">दायां हाथ (कर्मक)</span>
              <span class="polarity-sub">MANIFESTED REALITY</span>
            </button>
            <button class="polarity-btn" data-polarity="left" type="button">
              <span class="polarity-main">बायां हाथ (अकर्मक)</span>
              <span class="polarity-sub">KARMA &amp; POTENTIAL</span>
            </button>
          </div>

          <div class="polarity-note-box">
            <span class="note-glyph">ℹ</span>
            <span>कर्मक हाथ प्रकट कर्म दर्शाता है, अकर्मक हाथ मूल संस्कार।</span>
          </div>
        </div>
      </section>

      <!-- Main Examination Workspace Grid -->
      <div class="examination-workspace-grid">

        <!-- Left: Archival Examination Frame (Image Preview & Scanning Experience) -->
        <div class="examination-plate-col" id="specimen-plate-container">
          <div class="archival-plate-heading">
            <span class="plate-ref">PLATE VII-A</span>
            <span class="plate-title-text">HASTA SPECIMEN • हस्त प्रतिदर्श</span>
          </div>

          <!-- Archival Examination Frame -->
          <div class="archival-examination-frame">
            <!-- Manuscript Corner Marks -->
            <span class="archival-corner corner-tl">⌜</span>
            <span class="archival-corner corner-tr">⌝</span>
            <span class="archival-corner corner-bl">⌞</span>
            <span class="archival-corner corner-br">⌟</span>

            <!-- Marginal Measurement Marks (Ruler) -->
            <div class="ruler-vertical ruler-left" aria-hidden="true">
              <span>0</span><span>2</span><span>4</span><span>6</span><span>8</span><span>10</span><span>12</span><span>14</span>
            </div>
            <div class="ruler-horizontal ruler-bottom" aria-hidden="true">
              <span>0</span><span>2</span><span>4</span><span>6</span><span>8</span><span>10</span><span>12</span>
            </div>

            <!-- Header inside preview -->
            <div class="frame-inner-header">
              <span class="frame-tag">FOLIO VII</span>
              <span class="frame-folio-name">HASTA PARIKSHA</span>
            </div>

            <!-- Specimen Display (Image Feed / Camera Feed) -->
            <div class="specimen-canvas-wrap">
              <video id="camera-feed" class="specimen-video" autoplay playsinline muted style="display:none;"></video>
              <img id="image-feed" class="specimen-img" src="/images/palm-base.jpg" alt="परीक्षण हेतु हस्त प्रतिदर्श • Calibrated Palm Specimen" />

              <!-- Subtle manuscript grid lines -->
              <svg class="specimen-grid-svg" viewBox="0 0 500 620" preserveAspectRatio="none" aria-hidden="true">
                <!-- Center vertical axis of Saturn -->
                <line x1="250" y1="40" x2="250" y2="580" stroke="rgba(149, 102, 61, 0.35)" stroke-width="1" stroke-dasharray="4 4" />
                <!-- Horizontal axis across mounts -->
                <line x1="40" y1="310" x2="460" y2="310" stroke="rgba(149, 102, 61, 0.35)" stroke-width="1" stroke-dasharray="4 4" />
                
                <!-- Crosshairs -->
                <circle cx="250" cy="310" r="18" fill="none" stroke="rgba(142, 29, 18, 0.4)" stroke-width="1" stroke-dasharray="2 2" />
                <circle cx="250" cy="310" r="2" fill="#8E1D12" />

                <!-- Subtle measurement ticks -->
                <line x1="240" y1="180" x2="260" y2="180" stroke="rgba(149, 102, 61, 0.5)" stroke-width="1" />
                <line x1="240" y1="450" x2="260" y2="450" stroke="rgba(149, 102, 61, 0.5)" stroke-width="1" />
              </svg>
            </div>

            <!-- SCANNING EXPERIENCE OVERLAY (Hidden until user clicks हस्तपठन प्रारम्भ करें) -->
            <div id="scanning-overlay" class="scanning-experience-overlay" aria-live="polite">
              <div class="scan-parchment-backdrop"></div>
              
              <!-- Slow ink scanning line (NOT futuristic laser) -->
              <div class="slow-ink-scan-line"></div>

              <!-- In-progress drawn annotations -->
              <svg class="scanning-sketch-svg" viewBox="0 0 500 620" preserveAspectRatio="none">
                <!-- Dynamic ink paths appearing -->
                <path class="ink-draw-path path-heart" d="M160 300 C240 310 330 270 410 240" stroke="#8E1D12" stroke-width="2" fill="none" />
                <path class="ink-draw-path path-head" d="M150 335 C230 350 340 375 425 435" stroke="#95663D" stroke-width="2" fill="none" />
                <path class="ink-draw-path path-life" d="M230 260 C190 330 180 470 265 570" stroke="#8E1D12" stroke-width="2" fill="none" />
                <path class="ink-draw-path path-fate" d="M250 560 L250 280" stroke="#95663D" stroke-dasharray="4 4" stroke-width="1.5" fill="none" />
              </svg>

              <!-- Archival Inspection Card -->
              <div class="scanning-inspection-card">
                <div class="inspection-header">
                  <span class="inspection-folio">FOLIO VII</span>
                  <span class="inspection-title">HASTA PARIKSHA</span>
                </div>

                <div class="inspection-headline">हस्तचिह्न का निरीक्षण जारी है...</div>

                <!-- Animated message -->
                <div class="inspection-animated-box">
                  <div class="inspection-quill-glyph">✒</div>
                  <div id="scan-animated-msg" class="inspection-animated-msg">
                    रेखा-संरचना अंकित की जा रही है...
                  </div>
                </div>

                <!-- Status Checklist -->
                <div class="inspection-checklist">
                  <div class="scan-status-item" id="scan-status-lines">
                    <span class="status-glyph">◌</span>
                    <span class="status-text">मुख्य रेखाएँ (रेखा-विन्यास)</span>
                  </div>
                  <div class="scan-status-item" id="scan-status-mounts">
                    <span class="status-glyph">◌</span>
                    <span class="status-text">पर्वत (ग्रह उत्थान)</span>
                  </div>
                  <div class="scan-status-item" id="scan-status-direction">
                    <span class="status-glyph">◌</span>
                    <span class="status-text">रेखा की दिशा (प्रवाह गति)</span>
                  </div>
                  <div class="scan-status-item" id="scan-status-signs">
                    <span class="status-glyph">◌</span>
                    <span class="status-text">पारंपरिक संकेतों का मिलान</span>
                  </div>
                </div>

                <div class="inspection-note">
                  समुद्र संहिता एवं हस्तसंजीवन के आधार पर अभिलेख तैयार हो रहा है।
                </div>
              </div>
            </div>

            <!-- Footer archival label -->
            <div class="frame-inner-footer">
              <span>REF: HASTA-PARIKSHA-007</span>
              <span>18TH CENTURY VEDIC TRADITION</span>
            </div>
          </div>

          <!-- Primary CTA (Right below preview) -->
          <div class="preview-cta-block">
            <button id="btn-scan-trigger" class="btn-archive-primary btn-scan-primary" type="button">
              <span>हस्तपठन प्रारम्भ करें →</span>
            </button>
            <div class="scan-sub-hint">
              पठन प्रारम्भ करते ही हस्तचिह्न का विस्तृत अभिलेखीय विश्लेषण प्रस्तुत होगा।
            </div>
          </div>
        </div>

        <!-- Right: Manuscript Upload Box & Instructions -->
        <div class="manuscript-controls-col">

          <!-- Framed Manuscript Upload Plate (NOT generic drag & drop) -->
          <div class="manuscript-upload-plate" id="manuscript-upload-plate">
            <div class="upload-plate-inner">
              <span class="upload-plate-tag">हस्तचिह्न संकलन • SPECIMEN ENTRY</span>

              <div class="upload-seal-mark">
                <span>ह</span>
              </div>

              <h2 class="upload-plate-title">हस्तचिह्न प्रस्तुत करें</h2>
              <p class="upload-plate-formats">JPG / PNG • अधिकतम 10 MB</p>

              <div class="upload-action-wrap">
                <button id="btn-upload-trigger" class="btn-manuscript-select" type="button">
                  [ चित्र चुनें ]
                </button>
                <input type="file" id="file-upload-input" accept="image/jpeg,image/png,image/webp" style="display:none;" />
              </div>

              <div class="camera-fallback-row">
                <button id="btn-toggle-camera" class="btn-camera-link" type="button">
                  <span>📷 कैमरा द्वारा हथेली दिखाएं</span>
                </button>
              </div>

              <div class="upload-plate-footer">
                <span>ARCHIVAL DOCUMENTATION PROTOCOL</span>
              </div>
            </div>
          </div>

          <!-- Archival Examination Directives (Guidelines) -->
          <div class="directives-plate">
            <div class="directives-heading">
              <span class="directives-badge">विधि निर्देश</span>
              <h3 class="directives-title">हस्त परीक्षण के शुद्ध नियम</h3>
            </div>

            <ol class="directives-list">
              <li>
                <span class="dir-num">१.</span>
                <div class="dir-content">
                  <strong>पर्याप्त व सम प्रकाश:</strong>
                  हथेली पर परछाई न पड़ने दें। प्राकृतिक दिन का प्रकाश सर्वोत्तम है।
                </div>
              </li>
              <li>
                <span class="dir-num">२.</span>
                <div class="dir-content">
                  <strong>तनावमुक्त हथेली:</strong>
                  उंगलियों को स्वाभाविक रूप से फैलाएं, हथेली को सिकोड़ें नहीं।
                </div>
              </li>
              <li>
                <span class="dir-num">३.</span>
                <div class="dir-content">
                  <strong>आभूषण मुक्त कलाई:</strong>
                  स्पष्ट पठन हेतु अंगूठियां व धागे यथासंभव हटा लें।
                </div>
              </li>
              <li>
                <span class="dir-num">४.</span>
                <div class="dir-content">
                  <strong>सीधा कोण:</strong>
                  कैमरा हथेली के ठीक सामने ९० अंश के समानांतर रखें।
                </div>
              </li>
            </ol>
          </div>

          <!-- Confidentiality & Scholarly Trust Note -->
          <div class="scholarly-trust-plate">
            <div class="trust-plate-header">
              <span class="trust-glyph">🔒</span>
              <span class="trust-title">अभिलेखीय शुचिता एवं गोपनीयता</span>
            </div>
            <p class="trust-desc">
              आपके द्वारा प्रस्तुत किया गया चित्र केवल इस पठन चक्र के दौरान ही विश्लेषित होता है। किसी बाह्य सर्वर पर आपकी निजी छवि स्थायी रूप से संचित नहीं की जाती।
            </p>
          </div>

        </div>

      </div>

      <!-- Historical Examination Note -->
      <section class="examination-scholarly-notes">
        <div class="scholarly-notes-frame">
          <div class="scholarly-notes-header">
            <span class="notes-tag">शास्त्रीय संदर्भ</span>
            <h3 class="notes-title">हस्तरेखा परीक्षण की प्राचीन विधि</h3>
          </div>
          <div class="scholarly-notes-grid">
            <div class="note-box">
              <h4 class="note-box-title">कर्मक बनाम अकर्मक हस्त</h4>
              <p class="note-box-desc">
                दक्षिण हस्त (दायां हाथ) वर्तमान जीवन में अर्जित कर्म, निर्णय और बाह्य उपलब्धियों को व्यक्त करता है; जबकि वाम हस्त (बायां हाथ) संचित प्रारब्ध, आंतरिक चेतना और वंशानुगत गुणों का दर्पण है।
              </p>
            </div>
            <div class="note-box">
              <h4 class="note-box-title">रेखाओं का गतिक स्वभाव</h4>
              <p class="note-box-desc">
                हस्तरेखा शास्त्र के अनुसार सूक्ष्म रेखाएं और शाखाएं चेतना के विकास, आहार-विहार और संकल्प के अनुसार प्रति ६ से १८ माह में परिवर्तित होती रहती हैं।
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline src="/js/ai-palm-analyzer.js"></script>
  <script is:inline src="/js/scanner.js"></script>
</Layout>
