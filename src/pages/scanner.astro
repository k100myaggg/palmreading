---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AuraPalm Free Interactive Palm Reading AI Scanner",
  "url": "https://palmreading-b0v.pages.dev/scanner.html",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "All",
  "description": "Real-time biometric palm reading scanner tool providing instant accurate chiromancy analysis for male and female seekers.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};
---

<Layout
  title="Interactive Palm Reading AI Scanner: Free Online Tool for Male & Female | AuraPalm"
  description="Use our free AI palm reading scanner tool online. Real-time biometric chiromancy analyzes Heart, Head, Life, and Fate lines with planetary mount calibration."
  keywords="palm reading ai, scanner, tool, free, palm reading online, palm reading for male, palm reading for female, palmistry scanner"
  activePage="scanner"
  jsonLd={jsonLd}
>
  <main class="scanner-page">
    <div class="container-wide">
      
      <!-- Stepper Progress Bar -->
      <div class="stepper-bar">
        <div class="step-chip completed">
          <span class="step-num">✓</span>
          <div class="step-text">
            <span class="step-status">Step 01</span>
            <span class="step-name">Hand Polarity</span>
          </div>
        </div>

        <div class="step-chip active">
          <span class="step-num">2</span>
          <div class="step-text">
            <span class="step-status">Active Stage</span>
            <span class="step-name">Palm Alignment</span>
          </div>
        </div>

        <div class="step-chip">
          <span class="step-num">3</span>
          <div class="step-text">
            <span class="step-status">Step 03</span>
            <span class="step-name">Meridian Detection</span>
          </div>
        </div>

        <div class="step-chip">
          <span class="step-num">4</span>
          <div class="step-text">
            <span class="step-status">Step 04</span>
            <span class="step-name">Destiny Synthesis</span>
          </div>
        </div>
      </div>

      <!-- Hand Polarity Selector -->
      <div class="polarity-bar">
        <div class="polarity-options">
          <button class="polarity-btn" data-polarity="left">
            <span>Left Hand</span>
            <span class="polarity-sub">(Karma &amp; Potential)</span>
          </button>
          <button class="polarity-btn active" data-polarity="right">
            <span>Right Hand</span>
            <span class="polarity-sub">(Manifested Reality)</span>
          </button>
        </div>
        <button class="polarity-help-btn" title="Learn hand polarity rules for male and female seekers" onclick="showToast('Right hand reveals manifested action; Left hand reveals subconscious karma.')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </button>
      </div>

      <!-- Scanner Workspace Grid -->
      <div class="scanner-viewport-grid">
        
        <!-- Left: Biometric Camera Viewport -->
        <div>
          <div class="scanner-chamber">
            <video id="camera-feed" class="chamber-video-feed" autoplay playsinline muted style="display:none;"></video>
            <img id="image-feed" class="chamber-image-feed" src="/images/palm-base.jpg" alt="Calibrated Palm Specimen for AI Scanning">

            <!-- Biometric HUD Overlay -->
            <div class="hud-overlay">
              <div class="scan-laser-line"></div>

              <div class="reticle-corner reticle-tl"></div>
              <div class="reticle-corner reticle-tr"></div>
              <div class="reticle-corner reticle-bl"></div>
              <div class="reticle-corner reticle-br"></div>

              <div class="hud-top-bar">
                <div class="hud-pill">
                  <span class="hud-dot-pulse"></span>
                  <span>BIOMETRIC TRACK: LOCK</span>
                </div>
                <div class="hud-pill" style="border-color: rgba(229, 185, 88, 0.4); color: var(--color-gold-primary);">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  <span>Lighting: 94% Optimal</span>
                </div>
              </div>

              <!-- Biometric Tracking Wireframe Overlay -->
              <svg style="position: absolute; inset: 0; width: 100%; height: 100%;" viewBox="0 0 500 600">
                <line x1="50" y1="350" x2="450" y2="350" stroke="var(--color-gold-primary)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.7"/>
                <line x1="250" y1="200" x2="250" y2="520" stroke="#fff" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6"/>

                <path d="M160 520 C140 500 120 400 100 320 C85 260 70 200 80 160 C90 130 120 140 135 180 C145 140 160 85 180 80 C200 75 210 110 220 160 C230 110 245 50 265 45 C285 40 295 80 300 150 C315 100 330 90 350 95 C370 100 370 150 365 210 C385 160 410 155 425 175 C440 195 430 260 410 310 C390 360 415 440 375 500 C340 540 200 550 160 520 Z"
                      fill="none" stroke="var(--color-gold-primary)" stroke-width="2" opacity="0.85" />
                
                <circle cx="250" cy="350" r="14" fill="none" stroke="var(--color-cyan-biometric)" stroke-width="2" class="pulse-node" />
                <circle cx="250" cy="350" r="4" fill="var(--color-gold-primary)" />
              </svg>

              <!-- Floating Real-Time Biometric Badges -->
              <div class="hud-floating-badge hud-badge-gold" style="top: 38%; right: 40px;">
                <span class="hud-dot-pulse" style="background:var(--color-gold-primary);"></span>
                <span>Heart Resonance: <strong>98.4% Confidence</strong></span>
              </div>

              <div class="hud-floating-badge hud-badge-violet" style="top: 48%; right: 40px;">
                <span class="hud-dot-pulse" style="background:var(--color-violet-mystic);"></span>
                <span>Vitality Arc (Life): <strong>96.8% Mapped</strong></span>
              </div>

              <div class="hud-guidance-pill" style="left: 50%; transform: translateX(-50%);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                </svg>
                <span>Hold still: Distance 11–13 in • <strong>OPTIMAL</strong></span>
              </div>
            </div>
          </div>

          <!-- Action Controls Below Viewport -->
          <div class="scanner-controls-row">
            <button id="btn-toggle-flash" class="scanner-btn-icon" title="Toggle Lighting Compensation" aria-label="Toggle flash">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </button>

            <button id="btn-toggle-reticle" class="scanner-btn-icon" title="Toggle Reticle Overlay" aria-label="Toggle reticle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="22" y1="12" x2="18" y2="12"></line>
                <line x1="6" y1="12" x2="2" y2="12"></line>
                <line x1="12" y1="6" x2="12" y2="2"></line>
                <line x1="12" y1="22" x2="12" y2="18"></line>
              </svg>
            </button>

            <!-- Main Scan Trigger -->
            <button id="btn-scan-trigger" class="scanner-btn-scan">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
              <span>SCAN &amp; ALIGN PALM MERIDIAN</span>
            </button>

            <!-- Upload Photo Trigger -->
            <button id="btn-upload-trigger" class="scanner-btn-upload">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>Upload Photo</span>
            </button>
            <input type="file" id="file-upload-input" accept="image/*" style="display:none;" />
          </div>
        </div>

        <!-- Right: Real-Time Biometrics Panel -->
        <div class="biometrics-panel">
          <div class="panel-card">
            <div class="panel-header-row">
              <span class="panel-eyebrow">REAL-TIME BIOMETRICS</span>
              <span class="badge-pill badge-violet">Chiromancy Engine 3.4</span>
            </div>
            <h3 class="panel-title">Preparing Your Meridian Reading</h3>
            <p class="panel-desc">
              The optical sensor decodes the micro-elevations of the Mounts of Venus and Apollo while tracing sacred crease vectors.
            </p>

            <div class="metric-checklist">
              <div class="metric-item">
                <span class="metric-name">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan-biometric)" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Mount of Venus &amp; Lunar Hill elevation
                </span>
                <span class="metric-status status-identified">Identified</span>
              </div>

              <div class="metric-item">
                <span class="metric-name">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan-biometric)" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Skin micro-grain &amp; crease clarity
                </span>
                <span id="status-crease" class="metric-status status-identified">Locked (HD)</span>
              </div>

              <div class="metric-item">
                <span class="metric-name">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold-primary)" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                  Fate &amp; Sun line intersection vectors
                </span>
                <span id="status-vectors" class="metric-status status-analyzing">Analyzing...</span>
              </div>
            </div>

            <!-- Resonance Progress Bar -->
            <div class="resonance-container">
              <div class="resonance-labels">
                <span>Biometric Matrix Resonance</span>
                <span id="resonance-percent-val" class="text-gold">38%</span>
              </div>
              <div class="resonance-bar-track">
                <div id="resonance-bar-fill" class="resonance-bar-fill" style="width: 38%;"></div>
              </div>
            </div>
          </div>

          <!-- Guidelines for Accuracy -->
          <div class="panel-card">
            <h4 style="font-size:0.85rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--color-gold-primary); margin-bottom:12px; display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              Guidelines for Accuracy
            </h4>

            <div class="guidelines-grid">
              <div class="guideline-box">
                <div class="guideline-title">Relaxed Extension</div>
                <div class="guideline-desc">Spread fingers naturally without straining skin tension.</div>
              </div>

              <div class="guideline-box">
                <div class="guideline-title">Flat Stance</div>
                <div class="guideline-desc">Avoid cupping the palm; maintain a level horizontal angle.</div>
              </div>

              <div class="guideline-box">
                <div class="guideline-title">Warm Radiance</div>
                <div class="guideline-desc">Prefer daylight or warm lamp; evade heavy cast shadows.</div>
              </div>

              <div class="guideline-box">
                <div class="guideline-title">Clean Canvas</div>
                <div class="guideline-desc">Remove heavy rings or metallic wristwear before scanning.</div>
              </div>
            </div>
          </div>

          <!-- Sanctuary Privacy Protocol -->
          <div class="privacy-card" id="privacy">
            <div class="privacy-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div>
              <div class="privacy-title">Sanctuary Privacy Protocol</div>
              <div class="privacy-desc">
                Your biometric palm geometry is tokenized on-device, encrypted via celestial zero-knowledge hashing, and permanently cleared post-reading.
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Ancient Wisdom & Guidance Accordion -->
      <section style="margin-top: 40px; margin-bottom: 60px;">
        <div class="section-header" style="text-align: left; margin-bottom: 24px;">
          <span class="section-eyebrow">ANCIENT WISDOM &amp; GUIDANCE</span>
          <h2 class="section-title" style="font-size: 1.6rem;">Dominant vs. Non-Dominant Palm Dynamics</h2>
          <p class="section-subtitle" style="margin: 0;">Select a question below to unfold celestial notes.</p>
        </div>

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-trigger" aria-expanded="false">
              <span>Why scan both palms?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="faq-content">
              Comparing both palms reveals your soul’s blueprint versus your realized accomplishments. Differences indicate your free will altering fate.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-trigger" aria-expanded="false">
              <span>Do lines evolve over time?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="faq-content">
              Yes. Minor lines, breaks, and branches change dynamically every 6–18 months in response to mental shifts, dietary changes, and major life decisions.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-trigger" aria-expanded="false">
              <span>Does line length mean lifespan?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="faq-content">
              A common myth. The Life Line indicates vitality, stamina, and immune resilience—not calendar longevity. Deep clarity signifies high inner energy.
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script is:inline src="/js/main.js"></script>
  <script is:inline src="/js/scanner.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.faq-trigger').forEach(trigger => {
        trigger.addEventListener('click', () => {
          const item = trigger.closest('.faq-item');
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
          trigger.setAttribute('aria-expanded', !isExpanded);
          item.classList.toggle('active');
        });
      });
    });
  </script>
</Layout>
