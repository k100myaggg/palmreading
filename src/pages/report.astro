            <span>डिजिटल अभिलेखीय प्रमाण-पत्र</span>
            <span class="text-free">समाहित</span>
          </div>
          <div class="ledger-total-row">
            <span>कुल विनिमय राशि:</span>
            <strong class="total-price-val">₹199</strong>
          </div>
        </div>

        <!-- Archival Payment Methods Selection -->
        <div class="payment-methods-stack">
          <label class="payment-method-option active">
            <input type="radio" name="payment_method" value="upi" checked />
            <div class="method-details">
              <span class="method-name">📱 UPI / QR कोड (Google Pay, PhonePe, Paytm)</span>
              <span class="method-sub">त्वरित एवं सुरक्षित सत्यापन</span>
            </div>
          </label>

          <label class="payment-method-option">
            <input type="radio" name="payment_method" value="card" />
            <div class="method-details">
              <span class="method-name">🏛️ नेटबैंकिंग / डेबिट व क्रेडिट कार्ड</span>
              <span class="method-sub">सभी भारतीय बैंक स्वीकृत</span>
            </div>
          </label>
        </div>

        <!-- Submit Button -->
        <div class="payment-submit-block">
          <button id="btn-confirm-payment" class="btn-archive-primary btn-lg btn-pay-action" type="button">
            <span>भुगतान पुष्टि करें — ₹199</span>
          </button>
          <span class="payment-safe-note">🔒 २५६-बिट एन्क्रिप्टेड सुरक्षित बैंक विनिमय</span>
        </div>
      </div>

      <!-- STAGE 2: ARCHIVE ENTRY CONFIRMED STATE (Exact Required Format) -->
      <div id="payment-confirmed-stage" style="display:none;">
        <span class="modal-folio-stamp confirmed-badge">ARCHIVE ENTRY CONFIRMED</span>
        <h3 class="modal-plate-title confirmed-title">आपका अभिलेख सुरक्षित कर लिया गया है।</h3>
        
        <div class="confirmed-folio-box">
          <span class="confirmed-folio-label">FOLIO REFERENCE:</span>
          <strong class="confirmed-folio-num">FOLIO NO. HST-2026-0184</strong>
        </div>

        <div class="confirmed-progress-slate">
          <div class="confirmed-quill-icon">✒</div>
          <div class="confirmed-status-text">अभिलेख तैयार किया जा रहा है...</div>
          <div class="confirmed-ink-bar">
            <div class="confirmed-ink-fill" id="confirmed-ink-progress"></div>
          </div>
        </div>

        <div class="confirmed-cta-block">
          <button id="btn-open-confirmed-folio" class="btn-archive-primary btn-lg" type="button" disabled>
            <span>अपना अभिलेख खोलें →</span>
          </button>
          <p class="confirmed-note">अभिलेखीय पाण्डुलिपि के पृष्ठ मुद्रित हो रहे हैं...</p>
        </div>
      </div>

    </div>
  </div>

  <!-- PDF Export Language Selection Modal -->
  <div id="pdf-lang-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="pdf-modal-title">
    <div class="archival-modal-card">
      <button id="close-pdf-lang-modal" class="modal-close-plate" aria-label="Close modal">✕</button>

      <span class="modal-folio-stamp">FOLIO EXPORT PROTOCOL</span>
      <h3 id="pdf-modal-title" class="modal-plate-title">अभिलेख पाण्डुलिपि भाषा चुनें</h3>
