---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Report",
  "name": "Hastarekha Personal Folio • Hasta 001",
  "description": "Authentic archival palmistry folio decoding Ayur, Matisha, Hridaya, and Bhagya rekhas based on 18th-century Vedic Samudrika Shastra traditions.",
  "inLanguage": ["hi-IN", "en-IN"]
};
---

<Layout
  title="PERSONAL FOLIO • HASTA 001 | आपकी हस्तरेखा का अभिलेख"
  description="आपकी हस्तरेखा का व्यक्तिगत अभिलेख। जीवन, मस्तिष्क, हृदय एवं भाग्य रेखाओं का ऐतिहासिक पाण्डुलिपि विश्लेषण।"
  keywords="hastarekha record, palmistry folio, samudrika shastra report, ayur rekha, matisha rekha, hridaya rekha, bhagya rekha"
  activePage="report"
  jsonLd={jsonLd}
>
  <main class="folio-report-page">
    <div class="archive-container">

      <!-- Main Result Layout: Configured for Desktop Split & Exact Mobile Order -->
      <div class="folio-examination-layout">

        <!-- Folio Header Bar (Desktop: Spans across top / Mobile: Order 2) -->
        <header class="folio-header-plate">
          <div class="folio-top-meta">
            <div class="folio-identity-stamp">
              <span class="stamp-seal">ह</span>
              <div class="stamp-text">
                <span class="stamp-category">PERSONAL FOLIO • HASTA 001</span>
                <span class="stamp-sub">हस्तरेखा अभिलेखीय पाण्डुलिपि • पत्र संख्या ०१</span>
              </div>
            </div>

            <!-- Bilingual Switcher -->
            <div class="folio-lang-cluster">
              <span class="lang-label">भाषा / LANGUAGE:</span>
              <div class="lang-btn-group">
                <button id="btn-report-lang-hi" class="btn-archive-primary btn-sm" type="button">हिन्दी (Devanagari)</button>
                <button id="btn-report-lang-en" class="btn-archive-secondary btn-sm" type="button">English (Latin)</button>
              </div>
            </div>
          </div>

          <!-- Main Title Block -->
          <div class="folio-title-block">
            <h1 class="folio-main-title">आपकी हस्तरेखा का अभिलेख</h1>
            <p class="folio-main-subtitle">PERSONAL PALMISTRY RECORD</p>
            <p class="folio-editorial-desc">
              यह पाण्डुलिपि १८वीं शताब्दी की समुद्र-संहिता एवं प्राचीन हस्तसंजीवन ग्रंथों के आधार पर हस्त-चिह्नों, पर्वतों तथा रेखा-प्रवाह का अभिलेख प्रस्तुत करती है।
            </p>

            <div class="folio-chips-row">
              <span class="folio-chip" id="report-polarity-stamp">✋ दक्षिण हस्त (दायां • कर्मक)</span>
              <span class="folio-chip">📜 संकलन कोटि: प्रथम श्रेणी अभिलेख</span>
              <span class="folio-chip">✦ परीक्षण तिथि: आश्विन कृष्ण पक्ष</span>
            </div>
          </div>
        </header>

        <!-- ====================================================
             1. MOBILE ORDER 1 / DESKTOP LEFT: ANNOTATED PALM PLATE
             ==================================================== -->
        <section class="folio-palm-column" aria-label="हस्तरेखा आरेखन • Annotated Palm Plate">
          <div class="archival-plate-card">
            <div class="plate-top-legend">
              <span class="plate-number-tag">PLATE VII-01</span>
              <h2 class="plate-heading-title">हस्तरेखा आरेखन • ANNOTATED PALM</h2>
            </div>

            <!-- Interactive Line Toggles -->
            <div class="hand-toggles-cluster">
              <button class="hand-line-toggle" data-line="life" type="button">०१ — जीवन रेखा</button>
              <button class="hand-line-toggle" data-line="head" type="button">०२ — मस्तिष्क रेखा</button>
              <button class="hand-line-toggle active" data-line="heart" type="button">०३ — हृदय रेखा</button>
              <button class="hand-line-toggle" data-line="fate" type="button">०४ — भाग्य रेखा</button>
              <button class="hand-line-toggle" data-line="apollo" type="button">०५ — सूर्य रेखा</button>
            </div>

            <!-- Annotated Palm Canvas Frame -->
            <div class="archival-palm-canvas-frame">
              <!-- Corner Ticks -->
              <span class="canvas-corner corner-tl">⌜</span>
              <span class="canvas-corner corner-tr">⌝</span>
              <span class="canvas-corner corner-bl">⌞</span>
              <span class="canvas-corner corner-br">⌟</span>

              <!-- Ruler Marginal Ticks -->
              <div class="canvas-ruler-left" aria-hidden="true">
                <span>0</span><span>3</span><span>6</span><span>9</span><span>12</span><span>15</span>
              </div>
              <div class="canvas-ruler-bottom" aria-hidden="true">
                <span>0</span><span>2</span><span>4</span><span>6</span><span>8</span><span>10</span>
              </div>

              <!-- Base Palm Image -->
              <img id="annotated-palm-img" class="base-palm-image" src="/images/palm-base.jpg" alt="परीक्षित हस्त प्रतिदर्श • Examined Palm Specimen" />

              <!-- Overlay SVG: Historical Vermillion & Copper Ink Lines + Measurements -->
              <svg class="archival-lines-svg" viewBox="0 0 600 720">
                <!-- Subtle Archival Grid & Measurement Rings -->
                <circle cx="300" cy="420" r="140" stroke="rgba(149, 102, 61, 0.25)" stroke-width="1" fill="none" stroke-dasharray="6 4" />
                <circle cx="300" cy="420" r="210" stroke="rgba(149, 102, 61, 0.18)" stroke-width="1" fill="none" stroke-dasharray="4 6" />

                <!-- Dashed measurement axis lines -->
                <line x1="60" y1="360" x2="540" y2="360" stroke="rgba(149, 102, 61, 0.4)" stroke-width="1" stroke-dasharray="4 4" />
                <line x1="300" y1="120" x2="300" y2="660" stroke="rgba(149, 102, 61, 0.4)" stroke-width="1" stroke-dasharray="4 4" />

                <!-- 01: AYUR REKHA (Life Line) — Vermillion Line -->
                <path class="line-path-svg" data-line="life" d="M225 255 C185 325 175 465 260 565" stroke="#8E1D12" stroke-width="2.5" />
                <!-- 02: MATISHA REKHA (Head Line) — Copper Line -->
                <path class="line-path-svg" data-line="head" d="M145 330 C225 345 335 370 420 430" stroke="#95663D" stroke-width="2.5" />
                <!-- 03: HRIDAYA REKHA (Heart Line) — Vermillion Line (Active Default) -->
                <path class="line-path-svg active" data-line="heart" d="M155 295 C235 305 325 265 405 235" stroke="#8E1D12" stroke-width="3" />
                <!-- 04: BHAGYA REKHA (Fate Line) — Dashed Copper Line -->
                <path class="line-path-svg" data-line="fate" d="M305 580 L295 260" stroke="#95663D" stroke-width="2" stroke-dasharray="6 4" />
                <!-- 05: SURYA REKHA (Apollo Line) -->
                <path class="line-path-svg" data-line="apollo" d="M360 415 L365 245" stroke="#B78A43" stroke-width="2" />

                <!-- Mount Indicators (Subtle copper seals) -->
                <g class="mount-seal" transform="translate(205, 445)">
                  <circle cx="0" cy="0" r="22" stroke="rgba(149, 102, 61, 0.5)" stroke-width="1" fill="rgba(247, 239, 231, 0.75)" />
                  <text x="0" y="4" fill="#95663D" font-family="'Courier Prime', monospace" font-size="9" text-anchor="middle" font-weight="700">VENUS</text>
                </g>
                <g class="mount-seal" transform="translate(405, 505)">
                  <circle cx="0" cy="0" r="22" stroke="rgba(149, 102, 61, 0.5)" stroke-width="1" fill="rgba(247, 239, 231, 0.75)" />
                  <text x="0" y="4" fill="#95663D" font-family="'Courier Prime', monospace" font-size="9" text-anchor="middle" font-weight="700">LUNA</text>
                </g>
                <g class="mount-seal" transform="translate(215, 225)">
                  <circle cx="0" cy="0" r="20" stroke="rgba(142, 29, 18, 0.5)" stroke-width="1" fill="rgba(247, 239, 231, 0.75)" />
                  <text x="0" y="4" fill="#8E1D12" font-family="'Courier Prime', monospace" font-size="8" text-anchor="middle" font-weight="700">JUPITER</text>
                </g>

                <!-- Rare Marking: Mystic Cross -->
                <g transform="translate(300, 335)">
                  <line x1="-8" y1="-8" x2="8" y2="8" stroke="#8E1D12" stroke-width="2" />
                  <line x1="8" y1="-8" x2="-8" y2="8" stroke="#8E1D12" stroke-width="2" />
                  <circle cx="0" cy="0" r="12" stroke="#95663D" stroke-width="1" fill="none" stroke-dasharray="2 2" />
                </g>
              </svg>

              <!-- Numbered Markers Overlay (Pins for interactive clicking) -->
              <div class="annotated-marker-pin" data-line="life" style="top: 55%; left: 34%;">
                <span class="marker-dot"></span>
                <span class="marker-tag">01 — जीवन रेखा<br /><small>AYUR REKHA</small></span>
              </div>

              <div class="annotated-marker-pin" data-line="head" style="top: 52%; right: 30%;">
                <span class="marker-dot"></span>
                <span class="marker-tag">02 — मस्तिष्क रेखा<br /><small>MATISHA REKHA</small></span>
              </div>

              <div class="annotated-marker-pin active" data-line="heart" style="top: 36%; right: 28%;">
                <span class="marker-dot"></span>
                <span class="marker-tag">03 — हृदय रेखा<br /><small>HRIDAYA REKHA</small></span>
              </div>

              <div class="annotated-marker-pin" data-line="fate" style="bottom: 25%; left: 47%;">
                <span class="marker-dot"></span>
                <span class="marker-tag">04 — भाग्य रेखा<br /><small>BHAGYA REKHA</small></span>
              </div>

              <div class="annotated-marker-pin" data-line="apollo" style="top: 36%; right: 42%;">
                <span class="marker-dot"></span>
                <span class="marker-tag">05 — सूर्य रेखा<br /><small>SURYA REKHA</small></span>
              </div>
            </div>

            <!-- Selected Line Reading Box (Beneath palm canvas) -->
            <div id="inspector-detail-box" class="inspector-detail-wrapper">
              <!-- Populated dynamically via js/report.js -->
            </div>
          </div>
        </section>

        <!-- ====================================================
             2. DESKTOP RIGHT / MOBILE REMAINING SECTIONS
             ==================================================== -->
        <div class="folio-content-column">

          <!-- 2. MAIN FINDING / SUMMARY OVERVIEW -->
          <section class="main-finding-section" aria-label="मुख्य निष्कर्ष • Main Finding">
            <div class="finding-plate-card">
              <div class="finding-top-row">
                <span class="section-tag-mono">SANCTUARY SYNTHESIS • मुख्य निष्कर्ष</span>
                <span class="score-badge">९४ / १०० • सामंजस्य सूचकांक</span>
              </div>
              <h2 class="finding-title">प्राकृतिक रेखा-सामंजस्य एवं आत्मिक संधान</h2>
              <p class="finding-desc">
                परीक्षण उपरांत आपके हस्तचिह्न में जीवन, मस्तिष्क तथा हृदय रेखाओं का परस्पर समन्वय उत्कृष्ट स्थिति में पाया गया है। गुरु पर्वत की ओर हृदय रेखा का झुकाव तथा चंद्र पर्वत पर द्विमुखी मस्तिष्क रेखा आपकी प्रखर दूरदर्शिता, निश्छल नैतिक निष्ठा तथा स्वतंत्र उद्यमिता की पुष्टि करती है।
              </p>
            </div>
          </section>

          <!-- 3. MAJOR LINES SUMMARY (Show: जीवन रेखा / मस्तिष्क रेखा / हृदय रेखा / भाग्य रेखा) -->
          <section class="major-lines-summary-section" aria-label="प्रमुख चतुर्विध रेखाएँ • Major Lines">
            <div class="section-subheading-bar">
              <span class="subheading-mono">CORE MERIDIANS • चार प्रमुख रेखाएँ</span>
              <span class="subheading-ornament">❧</span>
            </div>

            <div class="major-lines-grid">
              <div class="major-line-summary-item" data-line-target="life">
                <div class="line-badge-num">01</div>
                <div class="line-summary-text">
                  <span class="line-title-hi">जीवन रेखा</span>
                  <span class="line-title-en">AYUR REKHA</span>
                  <span class="line-quick-val">दीर्घायु • सुदृढ़ प्राण शक्ति</span>
                </div>
              </div>

              <div class="major-line-summary-item" data-line-target="head">
                <div class="line-badge-num">02</div>
                <div class="line-summary-text">
                  <span class="line-title-hi">मस्तिष्क रेखा</span>
                  <span class="line-title-en">MATISHA REKHA</span>
                  <span class="line-quick-val">द्विमुख • प्रखर विवेक</span>
                </div>
              </div>

              <div class="major-line-summary-item" data-line-target="heart">
                <div class="line-badge-num">03</div>
                <div class="line-summary-text">
                  <span class="line-title-hi">हृदय रेखा</span>
                  <span class="line-title-en">HRIDAYA REKHA</span>
                  <span class="line-quick-val">गुरु पर्वत गामी • निर्मल निष्ठा</span>
                </div>
              </div>

              <div class="major-line-summary-item" data-line-target="fate">
                <div class="line-badge-num">04</div>
                <div class="line-summary-text">
                  <span class="line-title-hi">भाग्य रेखा</span>
                  <span class="line-title-en">BHAGYA REKHA</span>
                  <span class="line-quick-val">स्वअर्जित यश • स्वतंत्र कर्म</span>
                </div>
              </div>

              <div class="major-line-summary-item" data-line-target="apollo">
                <div class="line-badge-num">05</div>
                <div class="line-summary-text">
                  <span class="line-title-hi">सूर्य रेखा</span>
                  <span class="line-title-en">SURYA REKHA</span>
                  <span class="line-quick-val">कीर्ति • समाज-सम्मान</span>
                </div>
              </div>
            </div>
          </section>

          <!-- 4. DETAILED INTERPRETATION: ARCHIVAL FOLIO PANELS (Plates I, II, III, IV) -->
          <section class="detailed-interpretation-section" aria-label="विस्तृत पठन फलक • Detailed Folio Plates">
            <div class="section-subheading-bar">
              <span class="subheading-mono">FOLIO PANELS • विस्तृत पाण्डुलिपि पठन</span>
              <span class="subheading-ornament">❧</span>
            </div>

            <!-- PLATE I: AYUR REKHA -->
            <article class="archival-folio-panel" id="plate-ayur">
              <div class="panel-meta-header">
                <span class="panel-folio-ref">PLATE I • AYUR REKHA</span>
                <span class="panel-meta-sutra">संहिता सूत्र ०८</span>
              </div>
              <h3 class="panel-line-name">जीवन रेखा</h3>
              <p class="panel-reading-body">
                शुक्र पर्वत को घेरती हुई स्पष्ट, अखण्डित जीवन रेखा शारीरिक आरोग्यता तथा जीवनी शक्ति की प्रचुरता का उद्घोष करती है। किसी भी प्रकार के अवरोध अथवा द्वीप का अभाव यह सिद्ध करता है कि कठिन परिस्थितियों में भी आपकी देह-चेतना तीव्र गति से स्वास्थ्य पुनर्प्राप्त करने में समर्थ है। मध्य भाग में उपस्थित सूक्ष्म मंगल रेखा कुलदेवता तथा पूर्वजों के संरक्षण का संकेत देती है।
              </p>
              <div class="panel-interpretation-box">
                <span class="interpretation-label">ARCHIVAL INTERPRETATION</span>
                <div class="interpretation-tags-row">
                  <span class="interpretation-chip">दीर्घ</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">निर्दोष</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">गहन</span>
                </div>
              </div>
            </article>

            <!-- PLATE II: MATISHA REKHA -->
            <article class="archival-folio-panel" id="plate-matisha">
              <div class="panel-meta-header">
                <span class="panel-folio-ref">PLATE II • MATISHA REKHA</span>
                <span class="panel-meta-sutra">संहिता सूत्र ११</span>
              </div>
              <h3 class="panel-line-name">मस्तिष्क रेखा</h3>
              <p class="panel-reading-body">
                तर्जनी एवं अंगूठे के संगम से निकलकर चंद्र पर्वत की दिशा में अग्रसर यह मस्तिष्क रेखा अंत में द्विमुखी (बुध-शाखा) रूप धारण करती है। सामुद्रिक शास्त्र के अनुसार इसे ‘लेखक-द्विमुख’ कहा गया है। यह आपको व्यावहारिक तार्किक गणना तथा दूरगामी रचनात्मक कल्पनाशीलता का दुर्लभ संतुलन प्रदान करता है। आप जटिल ज्ञान को सहज रूप से ग्रहण व संप्रेषित करने में निपुण हैं।
              </p>
              <div class="panel-interpretation-box">
                <span class="interpretation-label">ARCHIVAL INTERPRETATION</span>
                <div class="interpretation-tags-row">
                  <span class="interpretation-chip">द्विमुखी</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">प्रखर</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">संतुलित</span>
                </div>
              </div>
            </article>

            <!-- PLATE III: HRIDAYA REKHA (As in user's specification example) -->
            <article class="archival-folio-panel" id="plate-hridaya">
              <div class="panel-meta-header">
                <span class="panel-folio-ref">PLATE III • HRIDAYA REKHA</span>
                <span class="panel-meta-sutra">संहिता सूत्र १४</span>
              </div>
              <h3 class="panel-line-name">हृदय रेखा</h3>
              <p class="panel-reading-body">
                हृदय रेखा अनामिका के नीचे से एक सधी हुई वक्र गति में सीधे देवगुरु बृहस्पति के पर्वत पर विलीन होती है। यह पठन भावनात्मक गरिमा, आत्मीय निष्ठा तथा संबंधों में सतहीपन के प्रति स्वाभाविक वितृष्णा को रेखांकित करता है। आपकी संवेदनशीलता अत्यधिक सूक्ष्म है, किंतु गुरु पर्वत की छत्रछाया इसे बौद्धिक आत्मसंयम प्रदान करती है।
              </p>
              <div class="panel-interpretation-box">
                <span class="interpretation-label">ARCHIVAL INTERPRETATION</span>
                <div class="interpretation-tags-row">
                  <span class="interpretation-chip">मध्यम</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">स्पष्ट</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">संतुलित</span>
                </div>
              </div>
            </article>

            <!-- PLATE IV: BHAGYA REKHA -->
            <article class="archival-folio-panel" id="plate-bhagya">
              <div class="panel-meta-header">
                <span class="panel-folio-ref">PLATE IV • BHAGYA REKHA</span>
                <span class="panel-meta-sutra">संहिता सूत्र १८</span>
              </div>
              <h3 class="panel-line-name">भाग्य रेखा</h3>
              <p class="panel-reading-body">
                मणिबंध के समीप चंद्र पर्वत से प्रारंभ होकर मध्यमा उंगली (शनि पर्वत) की ओर अग्रसर यह रेखा स्वअर्जित सफलता का सर्वोच्च प्रमाण है। पैतृक सीमाओं से परे स्वतंत्र उद्यम, कला, वाणिज्य अथवा सार्वजनिक प्रतिष्ठा के माध्यम से आप अपने भाग्य का निर्माण स्वयं करते हैं। ३२वें वर्ष के उपरांत भाग्य रेखा में विशेष प्रखरता दृष्टिगोचर होती है।
              </p>
              <div class="panel-interpretation-box">
                <span class="interpretation-label">ARCHIVAL INTERPRETATION</span>
                <div class="interpretation-tags-row">
                  <span class="interpretation-chip">ऊर्ध्वगामी</span>
                  <span class="chip-sep">•</span>
                  <span class="interpretation-chip">स्वतंत्र</span>
                  <span class="chip-sep">•</span>
