---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://palmreading-b0v.pages.dev/#website",
      "url": "https://palmreading-b0v.pages.dev/",
      "name": "हस्तरेखा अभिलेख — HASTAREKHA ARCHIVE",
      "inLanguage": ["hi-IN", "en-IN"],
      "description": "प्राचीन भारतीय सामुद्रिक शास्त्र एवं हस्तरेखा परंपराओं पर आधारित डिजिटल पाण्डुलिपि अभिलेख।",
      "publisher": {
        "@type": "Organization",
        "name": "हस्तरेखा अभिलेख संकलन",
        "logo": {
          "@type": "ImageObject",
          "url": "https://palmreading-b0v.pages.dev/images/palm-base.jpg"
        }
      }
    },
    {
      "@type": "WebApplication",
      "@id": "https://palmreading-b0v.pages.dev/#app",
      "name": "हस्तरेखा अभिलेख डिजिटल पठन",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "199",
        "priceCurrency": "INR"
      }
    }
  ]
};
---

<Layout 
  title="हस्तरेखा अभिलेख — HASTAREKHA ARCHIVE | आपकी हथेली में एक प्राचीन अभिलेख है"
  description="आपकी हथेली की प्रमुख रेखाओं और पर्वतों का अध्ययन, प्राचीन हस्तरेखा परंपराओं से प्रेरित एक विस्तृत डिजिटल पठन के रूप में। Ancient Indian palmistry digitally preserved."
  keywords="हस्तरेखा अभिलेख, Hastarekha Archive, Samudrika Shastra, Palmistry manuscript, सामुद्रिक शास्त्र, हस्तरेखा, जीवन रेखा, मस्तिष्क रेखा, हृदय रेखा, भाग्य रेखा, ₹199"
  activePage="home"
  jsonLd={jsonLd}
>
  <main class="archive-main">
    
    <!-- =====================================================================
         1. ARCHIVE HERO SECTION
         ===================================================================== -->
    <section class="hero-folio-section">
      <div class="archive-page-frame">
        <!-- Archival Registration Marks -->
        <div class="frame-mark mark-top-left">⌜</div>
        <div class="frame-mark mark-top-right">⌝</div>
        <div class="frame-mark mark-bottom-left">⌞</div>
        <div class="frame-mark mark-bottom-right">⌟</div>

        <div class="hero-folio-grid">
          <!-- Left Column: Archival Text & Editorial -->
          <div class="hero-editorial">
            <!-- Archival Metadata Stamp -->
            <div class="folio-meta-badge">
              <span class="meta-label">अभिलेख संख्या • SAMUDRIKA / FOLIO 01</span>
            </div>

            <!-- Main Heading (Hindi as primary emotional, English as archival subtitle) -->
            <h1 class="folio-hero-title">
              आपकी हथेली में<br />
              <span class="folio-title-highlight">एक प्राचीन अभिलेख है</span>
            </h1>

            <!-- English Archival Label -->
            <div class="hero-archival-stamp">
              <span class="stamp-en">ANCIENT PALMISTRY</span>
              <span class="stamp-sep">•</span>
              <span class="stamp-en">DIGITALLY PRESERVED</span>
            </div>

            <!-- Supporting Hindi Copy -->
            <p class="folio-hero-description">
              आपकी हथेली की प्रमुख रेखाओं और पर्वतों का अध्ययन, प्राचीन हस्तरेखा परंपराओं से प्रेरित एक विस्तृत डिजिटल पठन के रूप में।
            </p>

            <!-- Archival Treatise Citation -->
            <div class="manuscript-quote-strip">
              <span class="sanskrit-verse">"हस्ते रेखा यतो दृष्टा भाग्यं तत्र विनिर्दिशेत्"</span>
              <span class="verse-reference">— सामुद्रिक तिलक, पत्र ३, श्लोक १२</span>
            </div>

            <!-- Primary & Secondary CTAs -->
            <div class="folio-actions">
              <a href="/scanner.html" class="btn-archive-primary btn-hero-cta">
                <span>हस्तरेखा पढ़ना प्रारम्भ करें</span>
                <span class="cta-arrow">→</span>
              </a>

              <a href="#protocol" class="btn-archive-secondary">
                <span>पठन विधि देखें</span>
              </a>
            </div>

            <!-- Archival Verification Ledger -->
            <div class="folio-mini-ledger">
              <div class="ledger-item">
                <span class="ledger-num">१२८</span>
                <span class="ledger-lbl">लक्षण बिंदु</span>
              </div>
              <div class="ledger-sep">|</div>
              <div class="ledger-item">
                <span class="ledger-num">४ मुख्य</span>
                <span class="ledger-lbl">रेखाएं</span>
              </div>
              <div class="ledger-sep">|</div>
              <div class="ledger-item">
                <span class="ledger-num">७</span>
                <span class="ledger-lbl">ग्रह पर्वत</span>
              </div>
              <div class="ledger-sep">|</div>
              <div class="ledger-item">
                <span class="ledger-num">२०२६</span>
                <span class="ledger-lbl">डिजिटल संस्करण</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Antique Palm Manuscript Plate -->
          <div class="hero-manuscript-plate-wrap">
            <div class="manuscript-plate-card">
              <!-- Plate Header -->
              <div class="plate-card-header">
                <div class="plate-title-group">
                  <span class="plate-tag">चित्रपट ०१ • PLATE I</span>
                  <span class="plate-sub">SAMUDRIKA HASTA LAKSHANA • FACSIMILE REPRODUCTION</span>
                </div>
                <div class="plate-seal-mini">
                  <span>प्रमाणित</span>
                </div>
              </div>

              <!-- Antique Engraved Palm Graphic with Annotation Callouts -->
              <div class="plate-illustration-viewport">
                <!-- SVG Antique Engraving of Palm Hand with Hatching & Thin Annotation Lines -->
                <svg class="antique-palm-svg" viewBox="0 0 540 640" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="हस्तरेखा सामुद्रिक शास्त्र पाण्डुलिपि चित्रपट">
                  <!-- Aged Paper Texture Shading & Border Reticles -->
                  <rect x="10" y="10" width="520" height="620" fill="none" stroke="var(--line)" stroke-width="1" stroke-dasharray="4 4" />
                  <rect x="18" y="18" width="504" height="604" fill="none" stroke="rgba(149,102,61,0.3)" stroke-width="0.8" />
                  
                  <!-- Millimeter Measurement Ticks on Left Border -->
                  <g class="ruler-ticks" stroke="var(--line)" stroke-width="0.8">
                    <line x1="18" y1="60" x2="26" y2="60" /><line x1="18" y1="100" x2="30" y2="100" /><line x1="18" y1="140" x2="26" y2="140" />
                    <line x1="18" y1="180" x2="30" y2="180" /><line x1="18" y1="220" x2="26" y2="220" /><line x1="18" y1="260" x2="30" y2="260" />
                    <line x1="18" y1="300" x2="26" y2="300" /><line x1="18" y1="340" x2="30" y2="340" /><line x1="18" y1="380" x2="26" y2="380" />
                    <line x1="18" y1="420" x2="30" y2="420" /><line x1="18" y1="460" x2="26" y2="460" /><line x1="18" y1="500" x2="30" y2="500" />
                    <line x1="18" y1="540" x2="26" y2="540" /><line x1="18" y1="580" x2="30" y2="580" />
                  </g>

                  <!-- 1840 Classical Woodcut/Copperplate Shading Hatch Lines -->
                  <g class="woodcut-hatching" stroke="var(--ink)" stroke-width="0.75" opacity="0.35">
                    <!-- Wrist & Heel Hatching -->
                    <line x1="180" y1="570" x2="320" y2="570" /><line x1="185" y1="576" x2="315" y2="576" /><line x1="192" y1="582" x2="308" y2="582" />
                    <!-- Venus Mount Hatching -->
                    <path d="M140 400 C155 420 170 450 185 490" />
                    <path d="M148 390 C165 415 180 445 195 480" />
                    <path d="M158 385 C175 410 190 440 205 470" />
                    <!-- Moon Mount Hatching -->
                    <path d="M360 410 C340 435 330 470 325 510" />
                    <path d="M350 395 C332 425 322 460 318 495" />
                    <!-- Palm Center Depression Shading -->
                    <line x1="240" y1="320" x2="270" y2="320" /><line x1="235" y1="328" x2="275" y2="328" /><line x1="230" y1="336" x2="280" y2="336" />
                  </g>

                  <!-- Anatomical Hand Engraving Contour -->
                  <path class="hand-contour-engraved"
                    d="M175 580 
                       C150 560 130 500 115 440 
                       C95 380 65 315 80 260 
                       C95 210 128 220 142 260 
                       C148 220 155 140 175 130 
                       C195 120 208 150 215 210 
                       C225 150 238 75 260 70 
                       C280 65 294 100 298 190 
                       C310 135 330 120 348 128 
                       C365 135 365 195 360 255 
                       C378 200 402 195 418 215 
                       C432 235 425 310 405 365 
                       C385 420 405 500 370 560 
                       C340 600 210 605 175 580 Z" 
                    fill="var(--paper-light)" 
                    stroke="var(--ink)" 
                    stroke-width="2.2" 
                    stroke-linecap="round" 
                    stroke-linejoin="round"
                  />

                  <!-- Phalange Joints & Knuckle Folds -->
                  <g class="joint-folds" stroke="var(--ink)" stroke-width="1.2" opacity="0.6">
                    <!-- Index Finger Folds -->
                    <path d="M165 180 C180 185 195 183 208 178" />
                    <path d="M172 225 C185 230 200 228 212 222" />
                    <!-- Middle Finger Folds -->
                    <path d="M245 130 C260 135 278 135 290 128" />
                    <path d="M248 185 C263 190 282 188 295 182" />
                    <!-- Ring Finger Folds -->
                    <path d="M330 175 C342 180 355 178 365 172" />
                    <path d="M328 225 C340 230 352 228 362 222" />
                    <!-- Little Finger Folds -->
                    <path d="M395 265 C405 270 415 268 422 262" />
                    <path d="M390 310 C400 315 410 312 418 306" />
                    <!-- Thumb Joint Folds -->
                    <path d="M102 285 C115 292 125 290 135 282" />
                  </g>

                  <!-- Wrist Bracelets (Manibandha Rekha) -->
                  <g class="wrist-bracelets" stroke="var(--copper)" stroke-width="1.5" stroke-linecap="round">
                    <path d="M170 565 C220 580 310 580 365 565" />
                    <path d="M175 575 C225 590 305 590 355 575" stroke-dasharray="3 3" />
                  </g>

                  <!-- Planetary Mount Zones (Engraved Stippling Contours) -->
                  <!-- 1. Jupiter Mount (Guru Parvat) -->
                  <circle cx="205" cy="275" r="24" stroke="var(--copper)" stroke-width="1" stroke-dasharray="2 2" fill="rgba(149,102,61,0.06)" />
                  <text x="205" y="278" font-family="var(--font-archive)" font-size="11" fill="var(--copper)" text-anchor="middle" font-weight="bold">♃</text>

                  <!-- 2. Saturn Mount (Shani Parvat) -->
                  <circle cx="270" cy="255" r="22" stroke="var(--line)" stroke-width="0.8" stroke-dasharray="2 2" fill="none" />
                  <text x="270" y="258" font-family="var(--font-archive)" font-size="10" fill="var(--ink-soft)" text-anchor="middle">♄</text>

                  <!-- 3. Sun Mount (Surya Parvat) -->
                  <circle cx="340" cy="270" r="20" stroke="var(--line)" stroke-width="0.8" stroke-dasharray="2 2" fill="none" />
                  <text x="340" y="273" font-family="var(--font-archive)" font-size="10" fill="var(--ink-soft)" text-anchor="middle">☉</text>

                  <!-- 4. Venus Mount (Shukra Parvat) -->
                  <path d="M140 370 C160 410 185 470 215 540 C170 530 135 480 120 420 Z" stroke="var(--copper)" stroke-width="1" stroke-dasharray="3 3" fill="rgba(149,102,61,0.05)" />
                  <text x="160" y="455" font-family="var(--font-archive)" font-size="12" fill="var(--copper)" font-weight="bold">♀</text>

                  <!-- ==========================================
                       THE 4 MAJOR CREASE LINES (CLASSICAL INK & VERMILLION)
                       ========================================== -->
                  <!-- A. LIFE LINE (जीवन रेखा / Ayur Rekha) — Vermillion Core -->
                  <path class="crease-life-line"
                    d="M170 295 C150 330 148 400 170 480 C185 530 205 550 215 560" 
                    stroke="var(--vermillion)" 
                    stroke-width="2.8" 
                    stroke-linecap="round"
                  />
                  <!-- Life Line Sister/Guard Branches -->
                  <path d="M162 380 C160 420 172 470 188 510" stroke="var(--vermillion-dark)" stroke-width="1.2" stroke-linecap="round" opacity="0.7" />

                  <!-- B. HEAD LINE (मस्तिष्क रेखा / Matisha Rekha) — Antique Copper -->
                  <path class="crease-head-line"
                    d="M168 295 C220 310 280 340 350 380 C365 390 375 400 385 410" 
                    stroke="var(--copper)" 
                    stroke-width="2.5" 
                    stroke-linecap="round"
                  />
                  <!-- Creative Fork on Head Line (Visionary Writer's Fork) -->
                  <path d="M330 368 C355 375 380 380 395 382" stroke="var(--copper)" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="4 2" />

                  <!-- C. HEART LINE (हृदय रेखा / Hridaya Rekha) — Vermillion -->
                  <path class="crease-heart-line"
                    d="M398 325 C340 310 270 300 230 285 C215 280 205 272 200 265" 
                    stroke="var(--vermillion)" 
                    stroke-width="2.6" 
                    stroke-linecap="round"
                  />
                  <!-- Branch reaching towards Jupiter Mount -->
                  <path d="M235 288 C225 275 218 260 215 250" stroke="var(--vermillion)" stroke-width="1.5" stroke-linecap="round" />

                  <!-- D. FATE LINE (भाग्य रेखा / Bhagya Rekha) — Saturn Meridian -->
                  <path class="crease-fate-line"
                    d="M265 555 C265 470 262 380 268 285" 
                    stroke="var(--ink-soft)" 
                    stroke-width="2.0" 
                    stroke-linecap="round" 
                    stroke-dasharray="6 4"
                  />

                  <!-- ==========================================
                       THIN ANNOTATION CALLOUT LINES & LABELS
                       (Subtle labels with thin vermillion/copper lines)
                       ========================================== -->
                  
                  <!-- 01: जीवन रेखा (Life Line) -->
                  <line x1="165" y1="440" x2="60" y2="440" stroke="var(--vermillion)" stroke-width="1.2" stroke-dasharray="3 3" />
                  <circle cx="165" cy="440" r="3.5" fill="var(--vermillion)" />
                  <rect x="25" y="420" width="105" height="38" fill="var(--paper-light)" stroke="var(--vermillion)" stroke-width="0.8" />
                  <text x="77" y="435" font-family="var(--font-hindi)" font-size="12" font-weight="600" fill="var(--vermillion)" text-anchor="middle">०१ • जीवन रेखा</text>
                  <text x="77" y="449" font-family="var(--font-archive)" font-size="9" fill="var(--ink-soft)" text-anchor="middle">AYUR REKHA</text>

                  <!-- 02: शुक्र पर्वत (Mount of Venus) -->
                  <line x1="150" y1="490" x2="60" y2="520" stroke="var(--copper)" stroke-width="1.2" stroke-dasharray="3 3" />
                  <circle cx="150" cy="490" r="3" fill="var(--copper)" />
                  <rect x="25" y="505" width="105" height="36" fill="var(--paper-light)" stroke="var(--copper)" stroke-width="0.8" />
                  <text x="77" y="520" font-family="var(--font-hindi)" font-size="11" font-weight="600" fill="var(--copper)" text-anchor="middle">०६ • शुक्र पर्वत</text>
                  <text x="77" y="533" font-family="var(--font-archive)" font-size="9" fill="var(--ink-soft)" text-anchor="middle">MOUNT OF VENUS</text>

                  <!-- 03: गुरु पर्वत (Mount of Jupiter) -->
                  <line x1="205" y1="260" x2="110" y2="175" stroke="var(--copper)" stroke-width="1.2" stroke-dasharray="3 3" />
                  <circle cx="205" cy="260" r="3" fill="var(--copper)" />
                  <rect x="50" y="155" width="110" height="36" fill="var(--paper-light)" stroke="var(--copper)" stroke-width="0.8" />
                  <text x="105" y="170" font-family="var(--font-hindi)" font-size="11" font-weight="600" fill="var(--copper)" text-anchor="middle">०५ • गुरु पर्वत</text>
                  <text x="105" y="183" font-family="var(--font-archive)" font-size="9" fill="var(--ink-soft)" text-anchor="middle">MOUNT OF JUPITER</text>

                  <!-- 04: हृदय रेखा (Heart Line) -->
                  <line x1="330" y1="310" x2="445" y2="280" stroke="var(--vermillion)" stroke-width="1.2" stroke-dasharray="3 3" />
                  <circle cx="330" cy="310" r="3.5" fill="var(--vermillion)" />
                  <rect x="390" y="260" width="115" height="38" fill="var(--paper-light)" stroke="var(--vermillion)" stroke-width="0.8" />
                  <text x="447" y="275" font-family="var(--font-hindi)" font-size="12" font-weight="600" fill="var(--vermillion)" text-anchor="middle">०३ • हृदय रेखा</text>
                  <text x="447" y="289" font-family="var(--font-archive)" font-size="9" fill="var(--ink-soft)" text-anchor="middle">HRIDAYA REKHA</text>

                  <!-- 05: मस्तिष्क रेखा (Head Line) -->
                  <line x1="320" y1="360" x2="445" y2="380" stroke="var(--copper)" stroke-width="1.2" stroke-dasharray="3 3" />
                  <circle cx="320" cy="360" r="3.5" fill="var(--copper)" />
                  <rect x="385" y="365" width="125" height="38" fill="var(--paper-light)" stroke="var(--copper)" stroke-width="0.8" />
                  <text x="447" y="380" font-family="var(--font-hindi)" font-size="12" font-weight="600" fill="var(--copper)" text-anchor="middle">०२ • मस्तिष्क रेखा</text>
                  <text x="447" y="394" font-family="var(--font-archive)" font-size="9" fill="var(--ink-soft)" text-anchor="middle">MATISHA REKHA</text>

                  <!-- 06: भाग्य रेखा (Fate Line) -->
                  <line x1="265" y1="440" x2="445" y2="480" stroke="var(--ink-soft)" stroke-width="1.2" stroke-dasharray="3 3" />
                  <circle cx="265" cy="440" r="3" fill="var(--ink-soft)" />
                  <rect x="390" y="465" width="115" height="38" fill="var(--paper-light)" stroke="var(--ink-soft)" stroke-width="0.8" />
                  <text x="447" y="480" font-family="var(--font-hindi)" font-size="12" font-weight="600" fill="var(--ink)" text-anchor="middle">०४ • भाग्य रेखा</text>
                  <text x="447" y="494" font-family="var(--font-archive)" font-size="9" fill="var(--ink-soft)" text-anchor="middle">BHAGYA REKHA</text>

                  <!-- Archival Authentication Stamp (Vermillion Circle) in Bottom Right -->
                  <g class="vermillion-archive-stamp" transform="translate(380, 520)">
                    <circle cx="45" cy="45" r="40" stroke="var(--vermillion)" stroke-width="1.6" stroke-dasharray="5 2" fill="none" opacity="0.85" />
                    <circle cx="45" cy="45" r="36" stroke="var(--vermillion)" stroke-width="0.8" fill="none" opacity="0.85" />
                    <path id="stampCurve" d="M15 45 A30 30 0 1 1 75 45" fill="none" />
                    <text font-family="var(--font-archive)" font-size="6.8" fill="var(--vermillion)" letter-spacing="1.2" font-weight="bold">
                      <textPath href="#stampCurve" startOffset="50%" text-anchor="middle">
                        HASTAREKHA ARCHIVE
                      </textPath>
                    </text>
                    <text x="45" y="42" font-family="var(--font-hindi)" font-size="8.5" fill="var(--vermillion)" text-anchor="middle" font-weight="bold">प्रमाणित</text>
                    <text x="45" y="54" font-family="var(--font-archive)" font-size="7" fill="var(--vermillion)" text-anchor="middle">2026</text>
                  </g>
                </svg>
              </div>

              <!-- Plate Card Footer Metadata -->
              <div class="plate-card-footer">
                <span class="plate-mono-tag">FOLIO HST-01 / PLATE I</span>
                <span class="plate-mono-tag">DIGITAL ARCHIVAL REPRODUCTION</span>
                <span class="plate-mono-tag">SCALE 1:1</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Archival Section Ornament Divider -->
    <div class="archive-section-divider">
      <div class="divider-line"></div>
      <div class="divider-fleuron">❦</div>
      <div class="divider-line"></div>
    </div>


    <!-- =====================================================================
         2. READING PROTOCOL SECTION
         ===================================================================== -->
    <section class="archive-protocol-section" id="protocol">
      <div class="archive-container">
        <!-- Section Header -->
        <div class="archive-section-header">
          <div class="archive-header-badge">
            <span class="archive-mono">अभिलेख संकलन विधि • FOLIO PROCEDURE</span>
          </div>
          <h2 class="archive-section-heading">पठन विधि</h2>
          <div class="archive-section-subheading">THE READING PROTOCOL</div>
          <p class="archive-section-desc">
            चार व्यवस्थित चरणों में आपकी हथेली का परीक्षण, शास्त्रीय मिलान और निजी अभिलेख की तैयारी।
          </p>
        </div>

        <!-- 4 Stages styled like Manuscript Chapters -->
        <div class="protocol-chapters-grid">
          <!-- Stage 01: Capture -->
          <article class="protocol-chapter-card">
            <div class="chapter-card-top">
              <span class="chapter-index">अध्याय ०१</span>
              <span class="chapter-code">STAGE 01</span>
            </div>
            <div class="chapter-inner">
              <h3 class="chapter-title-hi">हस्तचित्र</h3>
              <div class="chapter-title-en">CAPTURE</div>
              <div class="chapter-ornament">─ ❖ ─</div>
              <p class="chapter-text">
                स्पष्ट प्रकाश में अपनी हथेली का छायाचित्र लें। उंगलियों और हथेली की रेखाएं जितनी स्पष्ट होंगी, विश्लेषण उतना ही सूक्ष्म और शास्त्रीय होगा।
              </p>
              <div class="chapter-meta">
                <span class="archive-mono">विधि: प्राकृतिक प्रकाश • सीधा कोण</span>
              </div>
            </div>
          </article>

          <!-- Stage 02: Line Examination -->
          <article class="protocol-chapter-card">
            <div class="chapter-card-top">
              <span class="chapter-index">अध्याय ०२</span>
